<?xml version="1.0" encoding="utf-8"?>
<!-- Fast memo sheet: appears over the launcher when tapping the memo widget -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_memo_label"
        android:textColor="@color/widget_green"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/memo_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_input_bg"
        android:hint="@string/widget_memo_hint"
        android:textColorHint="@color/widget_muted"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:padding="10dp"
        android:minHeight="52dp"
        android:maxLines="4"
        android:inputType="textCapSentences|textMultiLine"
        android:gravity="top|start"
        android:imeOptions="flagNoExtractUi" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/memo_cancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_cancel"
            android:textColor="@color/widget_muted" />

        <Button
            android:id="@+id/memo_save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_save"
            android:textColor="@color/widget_green"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
