<?xml version="1.0" encoding="utf-8"?>
<!--
  Translucent HUD panel used by all three widgets.
  The launcher wallpaper shows through (85% opacity) while the midnight-blue
  gradient keeps the neon accents readable.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#D90C1832"
        android:centerColor="#D9081020"
        android:endColor="#E604070F"
        android:type="linear" />
    <corners android:radius="20dp" />
    <stroke
        android:width="1dp"
        android:color="#8025F4C8" />
</shape>
