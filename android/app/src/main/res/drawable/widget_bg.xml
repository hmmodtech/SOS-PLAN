<?xml version="1.0" encoding="utf-8"?>
<!-- HUD panel: midnight-blue gradient with a dark petrol edge -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#0C182A"
        android:endColor="@color/widget_bg"
        android:type="linear" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_border" />
</shape>
