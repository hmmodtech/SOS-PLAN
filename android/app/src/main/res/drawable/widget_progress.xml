<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing cyan-green progress bar: halo layer under the aqua→cyan fill -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Soft bloom behind the filled part (semi-transparent, slightly taller) -->
    <item android:id="@android:id/progress">
        <shape android:shape="rectangle">
            <corners android:radius="6dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/widget_aqua"
                android:centerColor="@color/widget_green"
                android:endColor="@color/widget_mint"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
